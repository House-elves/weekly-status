#!/usr/bin/env python3
import json
import smtplib
import subprocess
import sys
from datetime import datetime, timedelta
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText
from pathlib import Path

import anthropic

CONFIG_PATH = Path.home() / ".config" / "weekly-status" / "config"


def load_config():
    config = {}
    with open(CONFIG_PATH) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip()
    return config


def run_gh(args):
    result = subprocess.run(
        ["gh"] + args,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"gh command failed: {result.stderr}", file=sys.stderr)
        return []
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return []


def fetch_github_activity(since_date, config):
    github_user = config["GITHUB_USER"]

    prs = run_gh([
        "search", "prs",
        "--author", github_user,
        "--updated", f">={since_date}",
        "--limit", "50",
        "--json", "repository,title,state,url,updatedAt,createdAt,closedAt",
    ])

    issues = run_gh([
        "search", "issues",
        "--author", github_user,
        "--updated", f">={since_date}",
        "--limit", "50",
        "--json", "repository,title,state,url,updatedAt,createdAt,closedAt",
    ])

    exclude_orgs = set()
    if config.get("EXCLUDE_ORGS"):
        exclude_orgs = {o.strip() for o in config["EXCLUDE_ORGS"].split(",") if o.strip()}

    prs = [p for p in prs
           if p.get("repository", {}).get("nameWithOwner", "").split("/")[0] not in exclude_orgs
           and p.get("state") != "closed"]
    issues = [i for i in issues
              if i.get("repository", {}).get("nameWithOwner", "").split("/")[0] not in exclude_orgs]

    return {"pull_requests": prs, "issues": issues}


def generate_email_with_claude(activity, config, week_start, week_end):
    client = anthropic.Anthropic(api_key=config["ANTHROPIC_API_KEY"])
    name = config["DISPLAY_NAME"]

    prompt = f"""You are writing a weekly status email for {name}, a software engineer, to share with their team.
Based on the GitHub activity data below, create a well-structured HTML email with two main sections:

1. **Last Week** ({week_start} to {week_end}) — what was accomplished
2. **Next Week** — what's coming up, derived from open PRs (work in progress) and open issues (planned work)

The email title in the header should be "Status Update: {name}".

Content guidelines:
- Write in first person ("I merged...", "I'll be working on...")
- Group by project/repository within each section
- All PRs in the data are either merged or open (closed PRs are already filtered out)
- Last Week: merged PRs and closed issues are completed work
- Next Week: open PRs are in-progress work, open issues are planned/upcoming work
- Consolidate release/version-bump PRs (e.g. "Release 1.0.3", "Release 1.0.4", version bumps, POM restores) into a single summary line like "Shipped releases 1.0.3 through 1.0.6" — don't list each one individually
- Keep it compact — use simple list items with linked titles, not elaborate table rows
- Include links to the PRs and issues
- Add a brief summary paragraph at the top (2-3 sentences covering both last and next week)
- If there's no open work for next week, say something like "No open items — starting fresh"
- Output ONLY the HTML, no markdown fences or explanation

Visual style (use inline CSS, no external stylesheets):
- Dark navy header (#1e3a5f) with white title "Status Update: {name}" and subtle uppercase date label
- Summary block with a left blue accent border (#2e7bcf) on a light blue background (#eef4fb)
- Stat pills row below the summary: rounded badges showing counts (e.g. "30 PRs Merged", "11 Issues Closed") in green, amber, and blue tones
- Clear visual separation between "Last Week" and "Next Week" sections (e.g. large section headings)
- Repository sections with bold uppercase headers on a navy background pill (#3a5a8a)
- PR/issue lists as compact <ul> items with linked titles in blue (#1a5fb4)
- Section labels (e.g. "Merged", "Issues Closed") as small uppercase colored labels
- Subtle dividers between repository sections
- Light grey footer with centered auto-generated note
- Max width 680px, centered, white card with subtle shadow on #f4f5f7 background

GitHub activity data:
{json.dumps(activity, indent=2)}"""

    response = client.messages.create(
        model="claude-sonnet-4-6",
        max_tokens=16384,
        messages=[{"role": "user", "content": prompt}],
    )

    html = response.content[0].text
    if html.startswith("```"):
        html = html.split("\n", 1)[1]
    if html.endswith("```"):
        html = html.rsplit("```", 1)[0]
    return html.strip()


def send_email(html_body, config, week_start, week_end):
    name = config["DISPLAY_NAME"]
    msg = MIMEMultipart("alternative")
    msg["Subject"] = f"Status Update: {name} — {week_start} - {week_end}"
    msg["From"] = config["GMAIL_ADDRESS"]
    recipients = [r.strip() for r in config["SEND_TO"].split(",")]
    msg["To"] = ", ".join(recipients)

    msg.attach(MIMEText(html_body, "html"))

    with smtplib.SMTP("smtp.gmail.com", 587) as server:
        server.starttls()
        server.login(config["GMAIL_ADDRESS"], config["GMAIL_APP_PASSWORD"])
        server.sendmail(config["GMAIL_ADDRESS"], recipients, msg.as_string())


def main():
    preview = "--preview" in sys.argv

    config = load_config()

    required_always = ("GITHUB_USER", "DISPLAY_NAME", "ANTHROPIC_API_KEY")
    required_send = ("GMAIL_ADDRESS", "GMAIL_APP_PASSWORD", "SEND_TO")
    required = required_always if preview else required_always + required_send
    for key in required:
        if config.get(key, "CHANGE_ME") == "CHANGE_ME":
            print(f"Error: {key} not configured in {CONFIG_PATH}", file=sys.stderr)
            sys.exit(1)

    today = datetime.now()
    week_ago = today - timedelta(days=7)
    since_date = week_ago.strftime("%Y-%m-%d")
    week_start = week_ago.strftime("%B %d")
    week_end = today.strftime("%B %d, %Y")

    print(f"Fetching GitHub activity since {since_date}...")
    activity = fetch_github_activity(since_date, config)

    pr_count = len(activity["pull_requests"])
    issue_count = len(activity["issues"])
    print(f"Found {pr_count} PRs and {issue_count} issues")

    print("Generating email with Claude...")
    html_body = generate_email_with_claude(activity, config, week_start, week_end)

    if preview:
        preview_path = Path("/tmp/weekly-status-preview.html")
        preview_path.write_text(html_body)
        print(f"Preview saved to {preview_path}")
        subprocess.run(["xdg-open", str(preview_path)])
    else:
        print(f"Sending email to {config['SEND_TO']}...")
        send_email(html_body, config, week_start, week_end)

    print("Done!")


if __name__ == "__main__":
    main()
