#!/usr/bin/env python3
import json
import smtplib
import subprocess
import sys
from datetime import datetime, timedelta
from email.mime.text import MIMEText
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "weekly-status" / "config"


def load_config():
    config = {}
    with open(CONFIG_PATH) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip()
    return config


def run_gh(args):
    result = subprocess.run(
        ["gh"] + args,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"gh command failed: {result.stderr}", file=sys.stderr)
        return []
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return []


def fetch_github_activity(since_date, config):
    github_user = config["GITHUB_USER"]

    prs = run_gh([
        "search", "prs",
        "--author", github_user,
        "--updated", f">={since_date}",
        "--limit", "50",
        "--json", "repository,title,state,url,updatedAt,createdAt,closedAt",
    ])

    issues = run_gh([
        "search", "issues",
        "--author", github_user,
        "--updated", f">={since_date}",
        "--limit", "50",
        "--json", "repository,title,state,url,updatedAt,createdAt,closedAt",
    ])

    exclude_orgs = set()
    if config.get("EXCLUDE_ORGS"):
        exclude_orgs = {o.strip() for o in config["EXCLUDE_ORGS"].split(",") if o.strip()}

    prs = [p for p in prs
           if p.get("repository", {}).get("nameWithOwner", "").split("/")[0] not in exclude_orgs
           and p.get("state") != "closed"]
    issues = [i for i in issues
              if i.get("repository", {}).get("nameWithOwner", "").split("/")[0] not in exclude_orgs]

    return {"pull_requests": prs, "issues": issues}


def generate_email_with_claude(activity, config, week_start, week_end):
    name = config["DISPLAY_NAME"]

    prompt = f"""You are writing a weekly status email for {name}, a software engineer, to share with their team.
Based on the GitHub activity data below, write a plain-text email (no HTML, no styling).

Format it exactly like this structure:

Hi,

Status for {week_start} to {week_end}.

[2-3 sentence summary of the week's work and what's coming next]

## What was done during the last iteration

# Project: [repository name]

- [item 1]
- [item 2]

# Project: [another repository]

- [item 1]

## What is planned for the next iteration

# Project: [repository name]

- [item 1]
- [item 2]

Content guidelines:
- Write in first person ("I merged...", "I'll be working on...")
- "What was done" and "What is planned" are top-level sections, with projects listed under each
- Only include a project under a section if it has items for that section — omit it otherwise
- All PRs in the data are either merged or open (closed PRs are already filtered out)
- Merged PRs and closed issues are completed work (last iteration)
- Open PRs are in-progress work, open issues are planned/upcoming work (next iteration)
- Consolidate release/version-bump PRs into a single summary line like "Shipped releases 1.0.3 through 1.0.6"
- Keep it concise — short bullet points
- Include PR/issue URLs inline where relevant
- If there's no open work for next iteration, say "No open items"
- Output ONLY the plain text, no markdown fences or explanation

GitHub activity data:
{json.dumps(activity, indent=2)}"""

    result = subprocess.run(
        ["claude", "-p", "--model", "sonnet"],
        input=prompt,
        capture_output=True,
        text=True,
        timeout=120,
    )
    if result.returncode != 0:
        print(f"Claude failed: {result.stderr[:500]}", file=sys.stderr)
        sys.exit(1)

    text = result.stdout.strip()
    if text.startswith("```"):
        text = text.split("\n", 1)[1]
    if text.endswith("```"):
        text = text.rsplit("```", 1)[0]
    return text.strip()


def send_email(body, config, week_start, week_end):
    name = config["DISPLAY_NAME"]
    msg = MIMEText(body, "plain")
    msg["Subject"] = f"Status {name} - {week_start} to {week_end}"
    msg["From"] = config["GMAIL_ADDRESS"]
    recipients = [r.strip() for r in config["SEND_TO"].split(",")]
    msg["To"] = ", ".join(recipients)

    with smtplib.SMTP("smtp.gmail.com", 587) as server:
        server.starttls()
        server.login(config["GMAIL_ADDRESS"], config["GMAIL_APP_PASSWORD"])
        server.sendmail(config["GMAIL_ADDRESS"], recipients, msg.as_string())


def main():
    preview = "--preview" in sys.argv

    config = load_config()

    required_always = ("GITHUB_USER", "DISPLAY_NAME")
    required_send = ("GMAIL_ADDRESS", "GMAIL_APP_PASSWORD", "SEND_TO")
    required = required_always if preview else required_always + required_send
    for key in required:
        if config.get(key, "CHANGE_ME") == "CHANGE_ME":
            print(f"Error: {key} not configured in {CONFIG_PATH}", file=sys.stderr)
            sys.exit(1)

    today = datetime.now()
    week_ago = today - timedelta(days=7)
    since_date = week_ago.strftime("%Y-%m-%d")
    week_start = week_ago.strftime("%B %d")
    week_end = today.strftime("%B %d, %Y")

    print(f"Fetching GitHub activity since {since_date}...")
    activity = fetch_github_activity(since_date, config)

    pr_count = len(activity["pull_requests"])
    issue_count = len(activity["issues"])
    print(f"Found {pr_count} PRs and {issue_count} issues")

    print("Generating email with Claude...")
    body = generate_email_with_claude(activity, config, week_start, week_end)

    if preview:
        preview_path = Path("/tmp/weekly-status-preview.txt")
        preview_path.write_text(body)
        print(f"Preview saved to {preview_path}")
        subprocess.run(["xdg-open", str(preview_path)])
    else:
        print(f"Sending email to {config['SEND_TO']}...")
        send_email(body, config, week_start, week_end)

    print("Done!")


if __name__ == "__main__":
    main()
